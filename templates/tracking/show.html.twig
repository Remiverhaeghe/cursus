{% extends 'base.html.twig' %}

{% block title %}Suivi de {{ apprenticeship.apprentice.fullName }}{% endblock %}

{% block body %}
    <h1>{{ apprenticeship.apprentice.fullName }}</h1>
    <p class="muted">
        {{ apprenticeship.formation.name }} · {{ apprenticeship.cohort.name }}<br>
        Tuteur : {{ apprenticeship.tutor.fullName }} · {{ apprenticeship.company }}<br>
        Contrat du {{ apprenticeship.startDate|date('d/m/Y') }} au {{ apprenticeship.endDate|date('d/m/Y') }}
    </p>
    <p class="actions">
        <a class="button" href="{{ path('app_tracking_calendar', {id: apprenticeship.id}) }}">Calendrier</a>
        {% if is_granted('EXCHANGE_VIEW', apprenticeship) %}
            <a class="button" href="{{ path('app_exchange_index', {id: apprenticeship.id}) }}">Échanges</a>
        {% endif %}
    </p>

    {% include 'partials/_progress.html.twig' with {progress: progress, show_remaining: true} %}

    {% if form %}
        <section class="card">
            <h2>Nouvelle évaluation</h2>
            {{ form_start(form, {attr: {class: 'form'}}) }}
                {{ form_widget(form) }}
                <button type="submit">Enregistrer l'évaluation</button>
            {{ form_end(form) }}
        </section>
    {% endif %}

    <section class="card">
        <h2>Historique des évaluations</h2>
        {% if evaluations is empty %}
            <p class="muted">Aucune évaluation pour l'instant.</p>
        {% else %}
            <table id="history">
                <thead><tr><th>Date</th><th>Compétence</th><th>Niveau</th><th>Contexte</th><th>Évaluateur</th><th>Commentaire</th></tr></thead>
                <tbody>
                    {% for evaluation in evaluations %}
                        <tr>
                            <td>{{ evaluation.evaluatedAt|date('d/m/Y') }}</td>
                            <td>{{ evaluation.competence.code }}</td>
                            <td><span class="level level-{{ evaluation.level.value }}">{{ evaluation.level.value }}</span> {{ evaluation.level.label }}</td>
                            <td>{{ evaluation.context.label }}</td>
                            <td>{{ evaluation.evaluator.fullName }}</td>
                            <td>{{ evaluation.comment }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </section>
{% endblock %}
