{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <section class="card narrow">
        <h1>Connexion</h1>
        {% if error %}
            <p class="flash flash-error" role="alert">{{ error }}</p>
        {% endif %}
        <form method="post" action="{{ path('app_login') }}" class="form">
            <label for="email">Adresse e-mail</label>
            <input type="email" id="email" name="email" value="{{ last_username }}" autocomplete="email" required autofocus>

            <label for="password">Mot de passe</label>
            <input type="password" id="password" name="password" autocomplete="current-password" required>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit">Se connecter</button>
        </form>
        <p><a href="{{ path('app_password_forgotten') }}">Mot de passe oublié ?</a></p>
    </section>
{% endblock %}
