{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
    <section class="card narrow">
        <h1>Mot de passe oublié</h1>
        <p>Saisis l'adresse de ton compte : tu recevras un lien pour choisir un nouveau mot de passe.</p>
        {% if error %}
            <p class="flash flash-error" role="alert">{{ error }}</p>
        {% endif %}
        {{ form_start(form, {attr: {class: 'form'}}) }}
            {{ form_widget(form) }}
            <button type="submit">Recevoir le lien</button>
        {{ form_end(form) }}
        <p><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
    </section>
{% endblock %}
