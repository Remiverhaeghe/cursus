{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body %}
    <section class="card narrow">
        <h1>Nouveau mot de passe</h1>
        {{ form_start(form, {attr: {class: 'form'}}) }}
            {{ form_widget(form) }}
            <button type="submit">Enregistrer le mot de passe</button>
        {{ form_end(form) }}
    </section>
{% endblock %}
